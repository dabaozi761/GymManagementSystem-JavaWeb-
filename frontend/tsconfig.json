{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true, "module": "ESNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "skipLibCheck": true,
    "types": ["vite/client", "node"], "moduleResolution": "Bundler",
    "resolveJsonModule": true, "isolatedModules": true, "noEmit": true,
    "strict": true, "jsx": "preserve", "esModuleInterop": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts", "playwright.config.ts", "tests/**/*.ts"]
}
