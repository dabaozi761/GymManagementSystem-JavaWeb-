<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dabaozi.gymmanagementsystem.mapper.EquipmentMapper">

    <select id="pageEquipment" resultType="com.dabaozi.gymmanagementsystem.pojo.entity.Equipment">
        SELECT id,
               equipment_no,
               name,
               type,
               status,
               purchase_date,
               purchase_price,
               remark,
               create_time,
               update_time,
               del_flag
        FROM equipment
        WHERE del_flag = 0
        <if test="name != null and name != ''">
            AND name LIKE CONCAT('%', #{name}, '%')
        </if>
        <if test="type != null">
            AND type = #{type}
        </if>
        <if test="status != null">
            AND status = #{status}
        </if>
        ORDER BY create_time DESC
    </select>
</mapper>
